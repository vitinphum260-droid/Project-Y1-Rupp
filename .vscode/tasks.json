{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the active C++ file with MSYS2 UCRT64 g++."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: Build Restaurant System",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "-g",
                "Main.cpp",
                "Maincpp/Source Code/System.cpp",
                "Maincpp/Source Code/Menu.cpp",
                "Maincpp/Source Code/Bill.cpp",
                "-o",
                "Main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Project-Y1-Rupp/Restaurant Ordering System"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Build all Restaurant System files with MSYS2 UCRT64 g++."
        }
    ],
    "version": "2.0.0"
}
